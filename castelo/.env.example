# Copie para .env e preencha. O .env nao vai para o git.

# Tag da imagem do Caddy construida com infra/Dockerfile.caddy (plugins CrowdSec e Hostinger)
CADDY_IMAGE=

# Segredo de assinatura dos tokens JWT do backend
JWT_SECRET=

# Token da API da Hostinger, usado no desafio DNS-01 do certificado *.tamoai.tech
HOSTINGER_API_TOKEN=

# Chave do bouncer do Caddy (docker exec crowdsec cscli bouncers add caddy-bouncer)
CROWDSEC_API_KEY=
